<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.textbookmarketplace.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_browse"
            app:destination="@id/browseFragment"/>
        <action
            android:id="@+id/action_home_to_add"
            app:destination="@id/addTextbookFragment"/>
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/bookDetailFragment"/>
    </fragment>

    <fragment
        android:id="@+id/browseFragment"
        android:name="com.example.textbookmarketplace.ui.browse.BrowseFragment"
        android:label="Browse"
        tools:layout="@layout/fragment_browse">
        <action
            android:id="@+id/action_browse_to_detail"
            app:destination="@id/bookDetailFragment"/>
        <action
            android:id="@+id/action_browse_to_add"
            app:destination="@id/addTextbookFragment"/>
    </fragment>

    <fragment
        android:id="@+id/addTextbookFragment"
        android:name="com.example.textbookmarketplace.ui.add.AddTextbookFragment"
        android:label="Add Textbook"
        tools:layout="@layout/fragment_add_textbook">
        <argument
            android:name="edit_book_id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null"/>
    </fragment>

    <fragment
        android:id="@+id/myListingsFragment"
        android:name="com.example.textbookmarketplace.ui.mylistings.MyListingsFragment"
        android:label="My Listings"
        tools:layout="@layout/fragment_my_listings">
        <action
            android:id="@+id/action_myListings_to_add"
            app:destination="@id/addTextbookFragment"/>
        <action
            android:id="@+id/action_myListings_to_detail"
            app:destination="@id/bookDetailFragment"/>
    </fragment>

    <fragment
        android:id="@+id/bookDetailFragment"
        android:name="com.example.textbookmarketplace.ui.bookdetail.BookDetailFragment"
        android:label="Book Detail"
        tools:layout="@layout/fragment_book_detail">
        <argument
            android:name="book_id"
            app:argType="string"/>
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.textbookmarketplace.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings"/>

    <action
        android:id="@+id/action_mylistings_to_add"
        app:destination="@id/addTextbookFragment" />



</navigation>

