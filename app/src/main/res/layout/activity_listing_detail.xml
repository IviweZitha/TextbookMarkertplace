<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"

    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"

    android:layout_height="match_parent"

    android:background="@color/grey_100"

    tools:context="ui.ListingDetailActivity">



    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical">



        <!-- Top Section with Back Button -->

        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:padding="16dp"

            android:gravity="center_vertical">



            <!-- This ID matches ListingDetailActivity.java: findViewById(R.id.btnBack) -->

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnBack"

                style="@style/Widget.MaterialComponents.Button.TextButton"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="← Back"

                android:textColor="@color/colorPrimary" />



            <TextView

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Listing Details"

                android:textAlignment="center"

                android:textColor="@color/black"

                android:textSize="18sp"

                android:textStyle="bold" />



            <!-- Empty view to center the title -->

            <View

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:layout_weight="0"

                android:minWidth="80dp"/>

        </LinearLayout>



        <!-- Card 1: Book Details -->

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginHorizontal="16dp"

            android:layout_marginBottom="16dp"

            app:cardCornerRadius="12dp"

            app:cardElevation="2dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="16dp">



                <TextView

                    android:id="@+id/tvDetailTitle"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:textColor="@color/black"

                    android:textSize="22sp"

                    android:textStyle="bold"

                    tools:text="Introduction to Algorithms" />



                <TextView

                    android:id="@+id/tvDetailAuthor"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/grey_600"

                    android:textSize="16sp"

                    tools:text="by Thomas H. Cormen" />



                <TextView

                    android:id="@+id/tvDetailIsbn"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/grey_500"

                    android:textSize="14sp"

                    tools:text="ISBN: 978-0262033848" />



                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:orientation="horizontal">



                    <TextView

                        android:id="@+id/tvDetailEdition"

                        android:layout_width="0dp"

                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:textColor="@color/grey_700"

                        android:textSize="14sp"

                        tools:text="Edition: 4th" />



                    <TextView

                        android:id="@+id/tvDetailCondition"

                        android:layout_width="0dp"

                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:textColor="@color/green_700"

                        android:textSize="14sp"

                        tools:text="Condition: Good" />

                </LinearLayout>



                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:orientation="horizontal">



                    <TextView

                        android:id="@+id/tvDetailFaculty"

                        android:layout_width="0dp"

                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:textColor="@color/grey_700"

                        android:textSize="14sp"

                        tools:text="Faculty: Science" />



                    <TextView

                        android:id="@+id/tvDetailCourseCode"

                        android:layout_width="0dp"

                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:textColor="@color/colorPrimary"

                        android:textSize="14sp"

                        android:textStyle="bold"

                        tools:text="CSC313" />

                </LinearLayout>



                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:background="@color/grey_100"

                    android:orientation="horizontal"

                    android:padding="12dp">



                    <TextView

                        android:id="@+id/tvDetailPrice"

                        android:layout_width="0dp"

                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:textColor="@color/black"

                        android:textSize="24sp"

                        android:textStyle="bold"

                        tools:text="R350.00" />



                    <TextView

                        android:id="@+id/tvDetailCopies"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:background="@drawable/bg_copies_badge"

                        android:padding="8dp"

                        android:textColor="@color/green_700"

                        android:textSize="14sp"

                        android:textStyle="bold"

                        tools:text="3 copies left" />

                </LinearLayout>



            </LinearLayout>

        </androidx.cardview.widget.CardView>



        <!-- Card 2: Seller & Payment Details (This replaces the old broken snippet) -->

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginHorizontal="16dp"

            android:layout_marginBottom="16dp"

            app:cardCornerRadius="12dp"

            app:cardElevation="2dp">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="16dp">



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Seller &amp; Payment Info"

                    android:textColor="@color/colorPrimary"

                    android:textSize="16sp"

                    android:textStyle="bold" />



                <TextView

                    android:id="@+id/tvDetailSellerName"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:textColor="@color/black"

                    android:textSize="16sp"

                    android:textStyle="bold"

                    tools:text="John Doe" />



                <TextView

                    android:id="@+id/tvDetailSellerEmail"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textSize="14sp"

                    tools:text="john.doe@example.com" />



                <TextView

                    android:id="@+id/tvDetailListingDate"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textSize="14sp"

                    android:textColor="@color/grey_500"

                    tools:text="Listed: 2024-05-01" />



                <View

                    android:layout_width="match_parent"

                    android:layout_height="1dp"

                    android:layout_marginTop="16dp"

                    android:layout_marginBottom="16dp"

                    android:background="@color/grey_200" />



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Banking Details (for EFT Payment)"

                    android:textColor="@color/black"

                    android:textSize="14sp"

                    android:textStyle="bold" />



                <TextView

                    android:id="@+id/tvPaymentInfo"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:background="@color/grey_100"

                    android:padding="12dp"

                    android:textSize="14sp"

                    android:textColor="@color/grey_700"

                    tools:text="Bank: FNB\nAcc: ******4589\nBranch: 250655" />



            </LinearLayout>

        </androidx.cardview.widget.CardView>



        <View

            android:layout_width="match_parent"

            android:layout_height="32dp"/>



    </LinearLayout>



</ScrollView>